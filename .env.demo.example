# ===================== MedFlow — демо-стенд =====================
# cp .env.demo.example .env.demo ; значения — ПЛЕЙСХОЛДЕРЫ, замените.
APP_MODE=demo
# Адрес, по которому зрители открывают стенд
APP_URL=http://localhost:8080
DEMO_PUBLIC_URL=http://localhost:8080
# Для показа по домену с HTTPS: DEMO_SITE=demo.example.ru, DEMO_HTTP_PUBLISH=80, DEMO_HTTPS_PUBLISH=443,
# APP_URL=https://demo.example.ru и уберите ALLOW_INSECURE_HTTP
DEMO_SITE=:80
ALLOW_INSECURE_HTTP=1
CLINIC_TZ=Europe/Moscow

SESSION_SECRET=CHANGE_ME_demo_min_32_chars_random_xxxxxxxxxxx
SERVICE_KEY=CHANGE_ME_demo_min_24_chars_xxxxxxx
POSTGRES_PASSWORD=CHANGE_ME_demo_db

# Пароль всех демо-учёток (показывается на экране входа демо-стенда)
DEMO_PASSWORD=CHANGE_ME_demo
# Ежедневный сброс демо-данных (время клиники)
DEMO_RESET_AT=04:00
DEMO_SMS_FAIL_RATE=0.08
TWO_FA_ROLES=ADMIN

# Мок-почта: консоль http://127.0.0.1:8025 (логин console)
EMAIL_CONSOLE_PASSWORD=CHANGE_ME_console

# Учебный SSO-провайдер (адрес должен открываться в браузере зрителя)
IDP_ISSUER=http://localhost:3041
IDP_CLIENT_ID=medflow-demo
IDP_CLIENT_SECRET=CHANGE_ME_idp_secret_16plus
IDP_REDIRECT_URIS=http://localhost:8080/api/auth/oidc/callback
DEMO_SSO_PASSWORD=CHANGE_ME_sso
OIDC_ISSUER=http://localhost:3041
OIDC_CLIENT_ID=medflow-demo
OIDC_CLIENT_SECRET=CHANGE_ME_idp_secret_16plus
OIDC_ROLE_MAP=mis-admins=ADMIN,mis-heads=HEAD,mis-registrars=REGISTRAR
OIDC_BUTTON_LABEL="Войти через корпоративный SSO (демо)"
REPORT_EMAIL_DOMAINS=medflow.demo
