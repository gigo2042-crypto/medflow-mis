# ===================== MedFlow — production =====================
# Скопируйте в .env и заполните. Все значения ниже — ПЛЕЙСХОЛДЕРЫ.
# Без обязательных переменных приложение не стартует (scripts/check-env.mjs).
# Секреты генерируйте:  openssl rand -base64 48

APP_MODE=production
# Публичный адрес (https). Из него строится redirect_uri OIDC: ${APP_URL}/api/auth/oidc/callback
APP_URL=https://mis.example.ru
# Домен для Caddy (автоматический HTTPS) и e-mail для Let's Encrypt
MEDFLOW_DOMAIN=mis.example.ru
ACME_EMAIL=admin@example.ru
# Часовой пояс клиники (IANA)
CLINIC_TZ=Europe/Moscow

# --- Секреты (обязательно) ---
SESSION_SECRET=CHANGE_ME_min_32_chars_random_string_xxxxxxxx
SERVICE_KEY=CHANGE_ME_min_24_chars_random_xxxxxxxx
# Подпись ссылок пациента в SMS/MAX (запись, лист ожидания, отписка). Отдельно от SESSION_SECRET:
# ротация сессий не ломает ссылки. Не короче 32 символов и не равен SESSION_SECRET.
LINK_SECRET=CHANGE_ME_min_32_chars_other_random_string_xxx
# Ротация LINK_SECRET: старый ключ сюда на время жизни ссылок, потом удалить
# LINK_SECRET_PREVIOUS=
# Срок жизни ссылок, дни: запись / лист ожидания / отписка / приглашение в MAX
# LINK_TTL_AP_DAYS=30
# LINK_TTL_WL_DAYS=7
# LINK_TTL_U_DAYS=400
# LINK_TTL_MAX_DAYS=30

# --- База данных ---
# Вариант А, свой сервер: Postgres в docker compose + ежедневные бэкапы
COMPOSE_PROFILES=localdb
POSTGRES_PASSWORD=CHANGE_ME_db_password_letters_digits_only
BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# Шифрование бэкапов: ключевая фраза — в файле ./secrets/backup_passphrase (docker secret),
# генерация: mkdir -p secrets && openssl rand -base64 32 > secrets/backup_passphrase && chmod 600 secrets/backup_passphrase
# Копия ВНЕ сервера обязательна: S3-совместимое хранилище (Yandex Object Storage и т.п.).
# Без BACKUP_S3_BUCKET бэкап считается неудачным (STATUS=FAIL, алерт). Осознанно только локально
# (пусконаладка): BACKUP_ALLOW_LOCAL_ONLY=1. Ключ secrets/backup_passphrase в бакет НЕ кладите.
BACKUP_S3_BUCKET=
# BACKUP_ALLOW_LOCAL_ONLY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Алерты: пинг после успешного бэкапа+проверки (тревога внешнего сервиса, если пинга нет) и вызов при ошибке
BACKUP_HEALTHCHECK_URL=
BACKUP_ALERT_URL=
# Вариант Б, облако: закомментируйте COMPOSE_PROFILES/POSTGRES_PASSWORD выше и задайте внешний URL
# DATABASE_URL=postgresql://medflow:CHANGE_ME@c-xxxx.rw.mdb.yandexcloud.net:6432/medflow?sslmode=require

# --- Вход ---
# Роли, обязанные проходить TOTP при входе по паролю (через запятую). По умолчанию — все роли
# с доступом к ПДн: ADMIN,REGISTRAR,DOCTOR,HEAD. Сужать — только решением ответственного за ПДн.
# TWO_FA_ROLES=ADMIN,REGISTRAR,DOCTOR,HEAD
TOTP_ISSUER=MedFlow
# Только для локальной проверки без TLS (НЕ для реальной работы):
# ALLOW_INSECURE_HTTP=1

# --- SSO (OpenID Connect, необязательно; задаются все четыре OIDC_* сразу) ---
# OIDC_ISSUER=https://keycloak.example.ru/realms/clinic
# OIDC_CLIENT_ID=medflow
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_ROLE_MAP=mis-admins=ADMIN,mis-heads=HEAD,mis-doctors=DOCTOR,mis-registrars=REGISTRAR,mis-marketing=MARKETER
# OIDC_GROUPS_CLAIM=groups
# OIDC_SCOPES=openid profile email
# OIDC_MFA_ROLES=                 # по умолчанию = TWO_FA_ROLES
# OIDC_MFA_ACR=
# OIDC_BUTTON_LABEL=Войти через корпоративный аккаунт

# --- SMS (SMS.ru) ---
SMS_PROVIDER=none
# SMS_PROVIDER=smsru
# SMSRU_API_ID=CHANGE_ME
# SMSRU_FROM=
# SMSRU_TEST=0

# --- E-mail (SMTP) ---
EMAIL_PROVIDER=none
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=noreply@example.ru
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=MedFlow <noreply@example.ru>
# Отчёты по расписанию — только на адреса этих доменов
REPORT_EMAIL_DOMAINS=example.ru

# --- Публичный виджет записи: Yandex SmartCaptcha (или WIDGET_ENABLED=0) ---
WIDGET_ENABLED=0
# SMARTCAPTCHA_CLIENT_KEY=CHANGE_ME
# SMARTCAPTCHA_SERVER_KEY=CHANGE_ME
# Сайты клиники, на которые можно встроить /book через embed.js (через пробел, только https://домен):
# WIDGET_ALLOWED_ORIGINS=https://clinic.example https://www.clinic.example

# --- ИИ-черновики протоколов (по умолчанию выключено) ---
# Данные пациента псевдонимизируются перед отправкой; для 152-ФЗ предпочтительны
# YandexGPT/GigaChat или локальная модель (openai-совместимый API внутри контура).
LLM_PROVIDER=none
# Внешний провайдер (YandexGPT, GigaChat, облачный OpenAI-совместимый) — только с явным флагом,
# иначе production не стартует. Локальная модель (LLM_BASE_URL внутри контура) флага не требует.
# LLM_EXTERNAL_ALLOWED=1
# LLM_PROVIDER=yandexgpt
# YANDEX_API_KEY=CHANGE_ME
# YANDEX_FOLDER_ID=CHANGE_ME
# YANDEX_MODEL=yandexgpt-lite
# LLM_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=CHANGE_ME
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://llm.internal:8000/v1
# LLM_API_KEY=CHANGE_ME
# LLM_MODEL=CHANGE_ME
# LLM_TIMEOUT_MS=30000

# --- Реквизиты клиники (обязательны для печати документов и чеков) ---
CLINIC_NAME=
CLINIC_SHORT_NAME=
CLINIC_INN=
CLINIC_OGRN=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_LICENSE=

# --- Онлайн-касса 54-ФЗ: АТОЛ Онлайн v5 (без настройки фискализация отключена) ---
# FISCAL_PROVIDER=atol
# ATOL_LOGIN=CHANGE_ME
# ATOL_PASSWORD=CHANGE_ME
# ATOL_GROUP_CODE=CHANGE_ME
# ATOL_SNO=usn_income
# ATOL_PAYMENT_ADDRESS=https://clinic.example
# ATOL_COMPANY_EMAIL=kassa@clinic.example
# ATOL_VAT=none
# ATOL_BASE_URL=   # пусто — боевой https://online.atol.ru/possystem/v5; для теста — тестовый адрес АТОЛ

# --- Касса: ограничители ---
# PAYMENT_MAX_RUB=1000000          # максимальная сумма одной оплаты, ₽
# DISCOUNT_MAX_PERCENT=10          # скидка выше — только по коду администратора
# DISCOUNT_APPROVAL_TTL_MIN=30     # срок действия кода на скидку, минуты

# --- Мессенджер MAX (без настройки все сообщения — по SMS) ---
# MAX_BOT_TOKEN=CHANGE_ME
# MAX_BOT_NAME=clinic_bot
# MAX_WEBHOOK_SECRET=CHANGE_ME   # openssl rand -hex 24
# после настройки: npm run max:subscribe

# --- Прочее ---
# STAFF_ALERT_EMAIL=admin@clinic.example   # служебные оповещения (склад, недоставленные письма)
# DOCTOR_SCOPE=own                         # own — врач видит только своих пациентов; all — всех
# TRUST_PROXY_HOPS=1                       # число обратных прокси перед app (Caddy = 1)
# PD_CONSENT_VERSION=2026-11               # название версии текста согласия на ПДн
# SCRYPT_MAX_PARALLEL=4                    # параллельных проверок пароля (scrypt) на процесс
# Права ролей без правки кода (JSON; врачебную тайну и ПДн маркетологу открыть нельзя), см. docs/ROLES.md:
# RBAC_OVERRIDES={"REGISTRAR":{"remove":["cash.read","cash.pay","cash.fiscalize"]},"HEAD":{"add":["cash.read"]}}

# --- Мониторинг (внешних аккаунтов не требует) ---
# Метрики Prometheus: GET /api/metrics с заголовком Authorization: Bearer <METRICS_TOKEN>
# (без токена эндпоинт выключен; снаружи через Caddy закрыт). Не короче 24 символов.
# METRICS_TOKEN=
# Логи: json (по умолчанию в production) | text
# LOG_FORMAT=json
# Отчёты об ошибках (Sentry/GlitchTip): выключено, пока не задан DSN. Внешний сервис — только
# с SENTRY_EXTERNAL_ALLOWED=1; лучше self-hosted GlitchTip внутри контура.
# SENTRY_DSN=https://<ключ>@glitchtip.clinic.internal/1
# SENTRY_EXTERNAL_ALLOWED=
# Лимит тела запроса в Caddy
# MEDFLOW_MAX_BODY=10MB
# Лимиты контейнеров (docker-compose.yml)
# APP_CPUS=2
# APP_MEMORY=1g
# PG_CPUS=2
# PG_MEMORY=2g
# Миграции от владельца БД, приложение — от роли без прав на изменение аудита (deploy/postgres/app-role.sql):
# DATABASE_URL_MIGRATE=postgresql://medflow:CHANGE_ME@postgres:5432/medflow
